generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  password        String
  role            String           @default("doctor")
  hospital_name   String?
  created_at      DateTime         @default(now())
  notifications   Notification[]
  orders          Order[]
  products        Product[]
  productRequests ProductRequest[]
  assignedRequests ProductRequest[] @relation("AssignedProductRequests")
  buyerQuotes      QuoteRequest[]   @relation("BuyerQuotes")
  supplierQuotes   QuoteRequest[]   @relation("SupplierQuotes")
  quoteMessages    QuoteMessage[]
}

model Product {
  id                  Int         @id @default(autoincrement())
  name                String
  category            String
  description         String
  price               Float
  stock               Int
  certification       String?
  is_quote_enabled    Boolean     @default(false)
  min_quote_quantity  Int?
  starting_quote_price Float?
  created_at          DateTime    @default(now())
  added_by            Int?
  orderItems          OrderItem[]
  quoteRequests       QuoteRequest[]
  admin               User?       @relation(fields: [added_by], references: [id])
}

model Order {
  id           Int         @id @default(autoincrement())
  user_id      Int
  total_price  Float
  status       String      @default("pending")
  created_at   DateTime    @default(now())
  amount_paid  Float       @default(0)
  payment_type String      @default("full")
  user         User        @relation(fields: [user_id], references: [id])
  items        OrderItem[]
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  order_id   Int
  product_id Int
  quantity   Int
  price      Float
  order      Order   @relation(fields: [order_id], references: [id])
  product    Product @relation(fields: [product_id], references: [id])
}

model ProductRequest {
  id            Int       @id @default(autoincrement())
  user_id       Int
  name          String
  description   String
  quantity      Int
  urgency       String    @default("normal")
  status        String    @default("pending")
  created_at    DateTime  @default(now())
  assigned_to   Int?
  claimed_at    DateTime?
  resolved_at   DateTime?
  user          User      @relation(fields: [user_id], references: [id])
  assignedAdmin User?     @relation("AssignedProductRequests", fields: [assigned_to], references: [id])
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  title      String
  message    String
  type       String   @default("info")
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
}

model QuoteRequest {
  id         String         @id @default(cuid())
  productId  Int
  buyerId    Int
  supplierId Int
  quantity   Int
  status     QuoteStatus    @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  product    Product        @relation(fields: [productId], references: [id])
  buyer      User           @relation("BuyerQuotes", fields: [buyerId], references: [id])
  supplier   User           @relation("SupplierQuotes", fields: [supplierId], references: [id])
  messages   QuoteMessage[]
}

model QuoteMessage {
  id        String       @id @default(cuid())
  quoteId   String
  senderId  Int
  message   String?
  price     Float?
  createdAt DateTime     @default(now())
  quote     QuoteRequest @relation(fields: [quoteId], references: [id])
  sender    User         @relation(fields: [senderId], references: [id])
}

enum QuoteStatus {
  PENDING
  NEGOTIATING
  ACCEPTED
  REJECTED
  EXPIRED
}
